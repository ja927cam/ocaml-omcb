[Unit]
Description=Deploy a new sim-map image from GHCR
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/opt/sim-map/deploy.sh
ConditionPathExists=/opt/sim-map/pull_agent.py

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/sim-map
EnvironmentFile=-/etc/sim-map/pull-agent.env
EnvironmentFile=-/etc/sim-map/ghcr.env
ExecStart=/usr/bin/python3 /opt/sim-map/pull_agent.py
UMask=0077
SyslogIdentifier=sim-map-pull
TimeoutStartSec=15min
