# Copy to /opt/sim-map/.env and keep it root-only (chmod 0600).
# Compose reads this file automatically.

# Let's Encrypt account email used by Caddy.
ACME_EMAIL=you@example.com

# Optional: override the image repository (defaults to the public GHCR image).
# APP_IMAGE=ghcr.io/ja927cam/sim-map

# Optional production tuning. The compose file already supplies the defaults
# shown here, matching deploy/env.example.
# SIM_MAP_ADAPTIVE=1
# SIM_MAP_ADAPTIVE_MAX=256
# SIM_MAP_WAL_GROUP=64
# SIM_MAP_WAL_SYNC=1
# SIM_MAP_SNAPSHOT_MOVES=100000
# SIM_MAP_SNAPSHOT_SECONDS=600
# CONNECTION_OUTBOX_CAPACITY=256
# EVENT_BATCHING=1
# EVENT_BATCH_WINDOW_MS=1
