# Bind address and port. Keep localhost behind a same-host TLS reverse proxy;
# containers need 0.0.0.0 so the published port can reach the process.
OCAML_OMCB_INTERFACE=localhost
OCAML_OMCB_PORT=8080

# Durable state. Back this directory up as a unit (snapshot + WAL).
OCAML_OMCB_DATA_DIR=/var/lib/ocaml-omcb/data

# Adaptive group commit is the default; fixed-64 is the fallback.
OCAML_OMCB_ADAPTIVE=1
OCAML_OMCB_ADAPTIVE_MAX=256
OCAML_OMCB_WAL_GROUP=64
OCAML_OMCB_WAL_SYNC=1

# Snapshot cadence. Lower MOVES for shorter recovery, higher for less I/O.
OCAML_OMCB_SNAPSHOT_MOVES=100000
OCAML_OMCB_SNAPSHOT_SECONDS=600

# Per-client outbox and event batching.
CONNECTION_OUTBOX_CAPACITY=256
EVENT_BATCHING=1
EVENT_BATCH_WINDOW_MS=1
