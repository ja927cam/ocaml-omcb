{
	email {$ACME_EMAIL:admin@jamesashwood.com}
}

chess.jamesashwood.com {
	encode zstd gzip

	# Public monitoring: /metrics (JSON) and /metrics.prom (Prometheus
	# text exposition). Expensive diagnostics stay internal to the Docker
	# network.
	#
	# route preserves this order: block internals first, proxy the rest.
	route {
		@internal path /state-hash /debug/*
		respond @internal 404

		# The HTML shell and the stable entrypoint must be revalidated so a
		# deploy/rollback switches client and server together. Dune's hashed
		# WASM chunks are content-addressed and can be cached forever.
		@nocache path / /status /static/main.bc.wasm.js /static/og.png
		header @nocache Cache-Control "no-cache"
		@hashed path /static/main.bc.wasm.assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			X-Frame-Options "DENY"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}

		# Caddy's reverse_proxy handles WebSocket upgrades (including /ws)
		# transparently. The app is never published directly to the host.
		reverse_proxy app:8080 {
			health_uri /healthz
			health_interval 30s
			health_timeout 5s
		}
	}

	log {
		output stdout
		format console
	}
}
