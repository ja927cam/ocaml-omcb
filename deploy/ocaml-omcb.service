[Unit]
Description=One Million Chessboards
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ocaml-omcb
Group=ocaml-omcb
WorkingDirectory=/var/lib/ocaml-omcb
EnvironmentFile=/etc/ocaml-omcb/env
ExecStart=/opt/ocaml-omcb/server.exe
Restart=on-failure
RestartSec=2
TimeoutStopSec=35
KillSignal=SIGTERM
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ocaml-omcb
ReadOnlyPaths=/opt/ocaml-omcb

[Install]
WantedBy=multi-user.target
