# Copy to /etc/ocaml-omcb/pull-agent.env (root-owned, mode 0600).
# The systemd service runs as root.

# Must match the image repository used by deploy/docker-compose.prod.yml.
APP_IMAGE=ghcr.io/ja927cam/ocaml-omcb

# Pull-agent state: last seen digest/SHA, failure backoff and lock.
STATE_DIR=/var/lib/ocaml-omcb-pull

# Optional: seconds to wait before retrying the same failed image digest.
# FAILURE_BACKOFF_SECONDS=1800

# For a private GHCR package, put a read-only credential in
# /etc/ocaml-omcb/ghcr.env instead:
#   GHCR_USERNAME=ja927cam
#   GHCR_TOKEN=ghp_...
# The systemd unit reads that file as root and both the agent and
# deploy.sh use it.
