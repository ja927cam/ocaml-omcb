[Unit]
Description=Hourly email report for chess.jamesashwood.com
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Work/sim-map
Environment=SIM_MAP_REPORT_URL=https://chess.jamesashwood.com
Environment=SIM_MAP_REPORT_TO=contact@jamesashwood.com
ExecStart=/usr/bin/python3 %h/Work/sim-map/scripts/hourly_report.py
TimeoutStartSec=120
Nice=10
